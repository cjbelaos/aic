    "test:purchase-order-numbering": "node scripts/test-purchase-order-numbering.mjs",
    "audit:child-row-gaps": "node --env-file=.env.local scripts/audit-child-row-gaps.mjs",
    "test:sales-orders": "npx tsc -p scripts/sales-order-tests/tsconfig.json && node tmp/sales-order-tests/out/scripts/sales-order-tests/run.js && node scripts/migrate-sales-orders.mjs --self-test && node scripts/test-sales-order-conversion.cjs",
    "test:quotations": "npx tsc -p scripts/quotation-tests/tsconfig.json && node tmp/quotation-tests/out/scripts/quotation-tests/run.js && node scripts/test-quotation-persistence.cjs && node scripts/test-quotation-print.cjs && node scripts/test-quotation-client.cjs && node scripts/test-quotation-send.cjs && node scripts/test-quotation-history.cjs && node scripts/test-quotation-api.cjs && node scripts/test-quotation-recipients.cjs",
    "test:service-reports": "npx tsc -p scripts/service-reports-tests/tsconfig.json && node tmp/service-reports-tests/out/scripts/service-reports-tests/run.js",
    "test:warehouses": "npx tsc -p scripts/warehouse-tests/tsconfig.json && node tmp/warehouse-tests/out/scripts/warehouse-tests/rules-test.js",
    "setup:inventory": "node --env-file=.env.local scripts/setup-inventory-sheets.mjs",
    "test:inventory": "npx tsc -p scripts/inventory-tests/tsconfig.json && node tmp/inventory-tests/out/scripts/inventory-tests/run.js && node scripts/test-inventory-lock.cjs",
    "test:purchase-requests": "npx tsc -p scripts/purchase-request-tests/tsconfig.json && node tmp/purchase-request-tests/out/scripts/purchase-request-tests/run.js",
    "test:contract-releases": "npx tsc -p scripts/contract-release-tests/tsconfig.json && node tmp/contract-release-tests/out/scripts/contract-release-tests/run.js",
    "setup:purchase-requests": "node --env-file=.env.local scripts/setup-purchase-request-sheets.mjs",
    "test:delivery-releases": "npx tsc -p scripts/delivery-release-tests/tsconfig.json && node tmp/delivery-release-tests/out/scripts/delivery-release-tests/run.js && node scripts/test-delivery-deletion.cjs && node scripts/test-delivery-service-errors.cjs",
    "test:proforma-invoices": "node scripts/test-proforma-invoices.cjs",
    "audit:proforma-migration": "node --env-file=.env.local scripts/migrate-proforma-invoices.cjs",
    "migrate:proforma-invoices": "node --env-file=.env.local scripts/migrate-proforma-invoices.cjs --apply",
    "test:sales-invoices": "node scripts/test-sales-invoices.cjs",
    "test:scanned-invoice-batch": "node scripts/test-scanned-invoice-batch.cjs",
    "test:service-invoice-billing": "node scripts/test-service-invoice-billing.cjs",
    "test:service-invoice-tracker": "node scripts/test-service-invoice-tracker.cjs",
    "verify:service-report-schema": "node --env-file=.env.local scripts/verify-service-report-schema.mjs",
    "backfill:service-report-types": "node --env-file=.env.local scripts/backfill-service-report-types.mjs",
    "apply:service-report-types": "node --env-file=.env.local scripts/backfill-service-report-types.mjs --apply",
    "inspect:sales-orders-destination": "node scripts/inspect-sales-order-destination.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
