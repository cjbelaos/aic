{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "noEmit": false,
    "rootDir": "../..",
    "outDir": "../../tmp/service-reports-tests/out"
  },
  "include": [
    "*.ts",
    "../../src/lib/serviceReports/errors.ts",
    "../../src/lib/serviceReports/ids.ts",
    "../../src/lib/serviceReports/constants.ts",
  "../../src/lib/serviceReports/reportRow.ts",
    "../../src/lib/serviceReports/labels.ts",
    "../../src/lib/serviceReports/domain.ts",
    "../../src/lib/serviceReports/validation.ts",
    "../../src/lib/serviceReports/permissions.ts",
    "../../src/lib/serviceReports/commands.ts",
    "../../src/lib/serviceReports/sequences.ts",
    "../../src/lib/serviceReports/storeTypes.ts",
    "../../src/lib/serviceReports/waterTreatmentDetails.ts",
    "../../src/lib/serviceReports/service.ts",
    "../../src/types/serviceReport.ts"
  ]
}